{
  "id": "codex",
  "version": "0.1.0",
  "name": "Codex CLI",
  "documentationURL": "https://github.com/chrisbraucker/devcontainer-features/tree/main/src/codex",
  "description": "Installs the official standalone Codex CLI package.",
  "mounts": [
    {
      "source": "codex-home-${devcontainerId}",
      "target": "/var/lib/codex-home",
      "type": "volume"
    }
  ],
  "options": {
    "version": {
      "type": "string",
      "default": "latest",
      "proposals": [
        "latest"
      ],
      "description": "Codex release to install."
    }
  }
}
